<div class="flexrow stacks">
  <div class="stack-size">
    <label>{{localize "PF1.Dialog.SplitItem.Keep"}}</label>
    <input type="number" value="{{keep}}" min="1" step="{{step}}" max="{{max}}" class="left" placeholder="1" required>
  </div>

  <div class="stack-drag">
    <label></label>
    <input type="range" value="{{initial}}" min="0" step="{{step}}" max="{{max}}" class="slider">
  </div>

  <div class="stack-size">
    <label>{{localize "PF1.Dialog.SplitItem.Split"}}</label>
    <input type="number" name="value" value="{{initial}}" min="1" step="{{step}}" max="{{max}}" class="quantity" placeholder="1" required>
  </div>
</div>
<div class="form-group flexcol" style="justify-content: center;">
    <label>{{localize "ls.quantityStack"}}</label>
    <input type="checkbox" min="1" id="quantityStack" name="quantityStack" {{#if quantityStack}}checked{{/if}} style="text-align: center; width: 25%;">
</div>